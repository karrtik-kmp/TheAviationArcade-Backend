# Local development only. Copy to .env (git-ignored). Local throwaway credentials, never real ones.
# Required: local | test | production. .env is loaded only when the real environment does not say production.
APP_ENV=local
DATABASE_URL=postgres://airplane:airplane_local_only@127.0.0.1:5433/airplane_games
# Used only by `npm run test:e2e`. The tests migrate and write to this database.
TEST_DATABASE_URL=postgres://airplane:airplane_local_only@127.0.0.1:5433/airplane_games_test
# Cloud project is airplane-games-auth-20261022; local and tests use only demo-airplane-games.
FIREBASE_PROJECT_ID=demo-airplane-games
# Accepts unsigned Auth Emulator tokens. Honoured only when FIREBASE_PROJECT_ID is exactly demo-airplane-games.
ALLOW_EMULATOR_TOKENS=true
PORT=3000
# Interface to listen on. Default 127.0.0.1; set 0.0.0.0 only in a container or deployment.
# HOST=127.0.0.1
# pg pool size. Default 10.
# DB_POOL_MAX=10
