# Local development only. Copy to .env (git-ignored). Local throwaway credentials, never real ones.
# Required: local | test | production. .env is loaded only when the real environment does not say production.
APP_ENV=local
DATABASE_URL=postgres://airplane:airplane_local_only@127.0.0.1:5433/airplane_games
# Used only by `npm run test:e2e`. The tests migrate and write to this database.
TEST_DATABASE_URL=postgres://airplane:airplane_local_only@127.0.0.1:5433/airplane_games_test
# Cloud project is airplane-games-auth-20261022; local and tests use only demo-airplane-games.
FIREBASE_PROJECT_ID=demo-airplane-games
# Accepts unsigned Auth Emulator tokens. Honoured only when FIREBASE_PROJECT_ID is exactly demo-airplane-games.
ALLOW_EMULATOR_TOKENS=true
PORT=3000
# Interface to listen on. Default 127.0.0.1; set 0.0.0.0 only in a container or deployment.
# HOST=127.0.0.1
# pg pool size. Default 10.
# DB_POOL_MAX=10
# Postgres TLS: disable | require | verify-full. Default disable locally; production requires verify-full
# (private CA: DATABASE_CA_CERT). Do not put sslmode in DATABASE_URL. Optional PEM CA (verify-full only):
# DATABASE_SSL=verify-full
# DATABASE_CA_CERT=
# Behind a reverse proxy/load balancer: number of proxy hops to trust for the client IP (default false).
# TRUST_PROXY=1
# How long SIGTERM waits for in-flight requests before exiting. Default 10000.
# SHUTDOWN_DRAIN_MS=10000
# Requests per minute: per verified principal (default 120) and per IP on public routes (default 60).
# RATE_LIMIT_AUTH_PER_MIN=120
# RATE_LIMIT_PUBLIC_PER_MIN=60
# Where rate-limit counters live: postgres (shared by every instance, default; needs migration 0014) or memory (per process).
# If the shared counter fails, requests are not refused and are counted per instance until it recovers (logged).
# RATE_LIMIT_STORE=postgres
# Size of the rate limiter's own small pg pool (default 3, in addition to DB_POOL_MAX).
# RATE_LIMIT_POOL_MAX=3
# Lowest accepted X-Client-Version build number. Unset = gate off.
# MIN_CLIENT_BUILD=
# SIGTERM: /ready answers 503 for SHUTDOWN_PRESTOP_MS (default 5000 in production, 0 elsewhere) before the
# listener closes; it counts inside SHUTDOWN_DRAIN_MS and must be smaller. Keep both below the host's
# termination grace period (Kubernetes default 30 s).
# SHUTDOWN_PRESTOP_MS=0
# Admin API (/v1/admin/*): admin and photographer access comes only from the account_roles table (Backend ADR-0002); no env list grants anything.
# Where staff-uploaded files go: memory (default locally; lost on restart) | bunny | none (default in production).
# BLOB_STORE=memory
# For BLOB_STORE=bunny: the website's zone, our own key prefix inside it. The password is the zone's read-write
# password (never the account API key). Never commit a real one; `npm run bunny:check` probes the connection.
# BUNNY_STORAGE_ZONE=aviation-arcade-website
# BUNNY_STORAGE_PASSWORD=
# BUNNY_STORAGE_REGION=de
# BUNNY_STORAGE_PREFIX=backend/
# Signed image links (Backend ADR-0001): the token-protected pull zone's hostname and its security key, both or neither.
# Both are required when APP_ENV=production; elsewhere without them an image preview has url null (reason cdn_not_configured).
# There is no default host: set it explicitly (the pull zone is named in plan task T10). While set, BUNNY_STORAGE_PREFIX must stay backend/.
# The key is a secret: never commit a real one.
# BUNNY_CDN_HOST=your-pull-zone.b-cdn.net
# BUNNY_CDN_TOKEN_KEY=
# UGS progress mirror (Phase 5.1): the first five or none (setting UGS_MIRROR_MAX_PER_MIN or UGS_MIRROR_MIN_INTERVAL_SEC alone fails too); blank values leave it off. The secret is a UGS service account
# secret (project roles Cloud Save Editor and Authentication Viewer; the Player Auth admin API must be enabled in the dashboard);
# never commit a real one. The ids below are The Aviation Arcade, development environment; they are not secrets.
# Uncomment all five together, once the service account exists; they need the real FIREBASE_PROJECT_ID, a demo- one is refused at startup. `npm run ugs:check` (see its header) sends nothing without --live.
# UGS_PROJECT_ID=4f07d0ca-51e9-4a95-8e47-6a7dc80fcf60
# UGS_ENVIRONMENT_ID=74439690-280a-4152-b69d-5f521fc18da0
# UGS_SERVICE_ACCOUNT_KEY_ID=
# UGS_SERVICE_ACCOUNT_SECRET=
# UGS_OIDC_PROVIDER=oidc-firebase
# Cloud Save calls per minute, 1-33 (UGS allows about 33/min sustained per project and IP). Default 25. Shared by all
# instances through one Postgres row: give every instance the same value.
# UGS_MIRROR_MAX_PER_MIN=25
# Least seconds between two Cloud Save copy writes for one player, 0-3600 (0 = no delay). Default 300. The first write
# after a link or re-link and all deletions are not delayed. Like the line above, setting it alone fails (the five above are required).
# UGS_MIRROR_MIN_INTERVAL_SEC=300
# Firebase uid of the website's shared demo account (a password handed to testers). That account can never hold the
# photographer or admin role: the roles guard ignores such a row and every grant/approve/request/import path refuses it
# (ADR-0002 follow-up, incident 2026-11-04). Not a secret. Set it wherever that account exists; unset = no demo account.
# DEMO_ACCOUNT_UID=
