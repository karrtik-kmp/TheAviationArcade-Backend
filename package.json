{
  "name": "airplane-games-backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start:dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "bunny:check": "nest build && node scripts/bunny-check.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/throttler": "6.7.1",
    "aws4fetch": "1.0.20",
    "drizzle-orm": "0.45.4",
    "express": "5.2.1",
    "fflate": "0.8.3",
    "jose": "6.2.13",
    "pg": "8.23.1",
    "pg-connection-string": "2.14.1",
    "read-excel-file": "9.3.12",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "write-excel-file": "4.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.3",
    "@swc/core": "1.16.18",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "ajv": "8.20.0",
    "drizzle-kit": "0.31.11",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "4.1.12",
    "yaml": "2.9.1"
  }
}
